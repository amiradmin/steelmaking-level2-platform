POSTGRES_DB=steelmaking_level2
POSTGRES_USER=level2
POSTGRES_PASSWORD=level2_dev_password
POSTGRES_PORT=5432

SIM_SAMPLE_INTERVAL_SECONDS=1
SIM_PHASE_DURATION_SECONDS=60
SIM_RESTART_DELAY_SECONDS=5
SIM_LOG_LEVEL=INFO

EAF_PLC_SIM_PORT=4842
LF_PLC_SIM_PORT=4843
CCM_PLC_SIM_PORT=4844
EAF_PLC_S7_PORT=1102
LF_PLC_S7_PORT=1103
CCM_PLC_S7_PORT=1104
PLC_SIM_SCAN_SECONDS=0.1
PLC_SIM_TIME_SCALE=60
PLC_SIM_EPOCH_UNIX=1788220800
PLC_SIM_HEAT_BASE=260001
PLC_SIM_HEAT_PITCH_MINUTES=70
EAF_PLC_SIM_CPU_MODE=RUN
LF_PLC_SIM_CPU_MODE=RUN
CCM_PLC_SIM_CPU_MODE=RUN
EAF_PLC_SIM_FAULT_MODE=NONE
LF_PLC_SIM_FAULT_MODE=NONE
CCM_PLC_SIM_FAULT_MODE=NONE

# Real Siemens S7-400 commissioning settings.
# Leave EAF_PLC_HOST unset during normal simulation. When using
# docker-compose.real-eaf.yml, set it to the real PLC IP address.
# The gateway uses read-only S7 DB reads over ISO-on-TCP / TCP 102.
EAF_PLC_HOST=
EAF_PLC_PORT=102
EAF_PLC_RACK=0
EAF_PLC_SLOT=2
# Full JSON map used by the gateway. During initial testing the simulator map is
# used; later point this to a reviewed copy containing the plant's actual DB map.
S7_ADDRESS_MAP_FILE=./backend/plc_simulators/s7_address_map.json

CENTRAL_OPCUA_PORT=4845
OPCUA_GATEWAY_POLL_SECONDS=0.5
OPCUA_GATEWAY_RECONNECT_SECONDS=2

HEAT_MANAGEMENT_PORT=9000
LEVEL2_API_PORT=8080
NGINX_PORT=80
API_CORS_ORIGINS=*
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=*
DB_CONN_MAX_AGE=60
JWT_ACCESS_MINUTES=15
JWT_REFRESH_HOURS=12
TELEMETRY_PUSH_INTERVAL_SECONDS=1.0
TELEMETRY_STALE_AFTER_SECONDS=5.0
DJANGO_BOOTSTRAP_USERNAME=OP-4109
DJANGO_BOOTSTRAP_PASSWORD=Level2Demo-1405
DJANGO_BOOTSTRAP_DISPLAY_NAME=Shift Operator

# Signed offline licensing. Keep enabled for local development; set to 0 on customer deployments.
LICENSE_ALLOW_UNLICENSED=1
LICENSE_TOKEN=
