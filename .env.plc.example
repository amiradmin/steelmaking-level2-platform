# Copy the values you need into the project's local .env file.
# Keep real PLC credentials out of Git.
PLC_OPCUA_ENDPOINT=opc.tcp://host.docker.internal:4840
PLC_OPCUA_USERNAME=
PLC_OPCUA_PASSWORD=
PLC_POLL_INTERVAL_SECONDS=1
PLC_RECONNECT_DELAY_SECONDS=5
PLC_LOG_LEVEL=INFO
PLC_HEALTH_STALE_AFTER_SECONDS=15
PLC_NODE_MAP_JSON={}
